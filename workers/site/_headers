# MySweetPea site — static-asset response headers (served by the assets layer).
# Replaces the per-request header block that used to live in the Worker.
# Deploy-time validated by Cloudflare (_headers syntax errors fail the deploy).
#
# CSP uses build-time sha256 hashes of the inline scripts (bake_html.py computes
# them). If you edit inline JS in any .html file, re-run:
#   python bake_html.py --check     -> prints the new hash list
# and update the script-src line below.
#
# CORP strategy (learned live): the base /* rule carries NO CORP. A base-rule
# CORP + per-page detach produced DUPLICATE conflicting values on `/`
# (same-origin AND cross-origin). Instead: pages set same-origin, asset
# extensions set cross-origin. No rule ever needs to detach.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: credentialless
  X-DNS-Prefetch-Control: off
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-4pv/aXysGXZwheaDF8xBE34VFvTP56VvYWM2elGRc7A=' 'sha256-7AYzvEJqQKo6cg8l1hd1EeOVII1jemyDKsJ6oqUPKKU=' 'sha256-8zbuit3FTDiXF4Kw1D4otbfkzLESs74mtOC/AQDriTY=' 'sha256-EdId8M5ecQUbIZhjSQqA1ACut8Bz0gJlYS+oDvrwvQY=' 'sha256-O3zrTdg/pQn4AtbosKMp/DKtItz2DrJQk436yWsUNRs=' 'sha256-Uyb06t/vsvzsyIHntpKqS7UJLzRwbz/kt4sazCcEnAU=' 'sha256-YdVprvfbXVCCyb3J7UlQ9GVHKPNtI+Fc4NIgRkujddo=' 'sha256-ZiirywCP0aSesXmthvDxQD/KrX8GYGqcdqlIDAhujNY=' 'sha256-dUiU5lJGc5PHrC/HZe/bEBE/soNRycWXeQzy68MNpUo=' 'sha256-nSC5vOLm7mCAZAss/ISo8+vYvXUiG0xUdsFCrnsWYG8=' 'sha256-oCL7QnUYnr0Jaj7ciVIoBUIdqqlKkfcbdSFTU/62sEE=' 'sha256-q+ucn2KX8FOorzD2ahLXAkN9wN3EkypgTJoynhK8MVg=' 'sha256-uZSx74DTfUf2/ZONbDpK5P5t9aFeKV4+9xKeWt++jT8=' 'sha256-xQyRIF9gPIoP2zhIaF2z42V7YsrqTiJUoq+hTSnjnAw='; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://subscribe.mysweetpea.cc https://status.mysweetpea.cc; object-src 'none'; base-uri 'self'; form-action 'self' https://subscribe.mysweetpea.cc; frame-ancestors 'none'; upgrade-insecure-requests

